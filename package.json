{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility-critical.spec.ts --project=desktop-chromium",
    "test:e2e:contrast": "playwright test tests/e2e/contrast-critical.spec.ts --project=desktop-chromium",
    "test:e2e:screen-reader": "playwright test tests/e2e/screen-reader-critical.spec.ts --project=desktop-chromium",
    "test:e2e:critical": "playwright test tests/e2e/critical-flows.spec.ts --project=desktop-chromium",
    "test:e2e:screenshots": "playwright test tests/e2e/visual-release.spec.ts --project=desktop-chromium",
    "test:e2e:perf": "playwright test tests/e2e/performance-baseline.spec.ts --project=mobile-chromium",
    "test:e2e:perf:throttled": "playwright test tests/e2e/performance-throttled.spec.ts --project=mobile-chromium",
    "test:lighthouse": "tsx scripts/lighthouse-release.ts",
    "security:secrets": "tsx scripts/security-audit.ts",
    "security:deps": "npm audit --audit-level=high",
    "security:moderates": "tsx scripts/advisory-status.ts",
    "security:audit": "npm run security:secrets && npm run security:deps && npm run security:moderates",
    "env:inventory": "tsx scripts/env-inventory.ts",
    "deployment:check": "tsx scripts/deployment-check.ts",
    "launch:evidence": "tsx scripts/launch-evidence.ts",
    "launch:readiness": "tsx scripts/launch-readiness.ts",
    "backup:restore-drill": "tsx scripts/backup-restore-drill.ts",
    "catalog:backfill-collections": "tsx scripts/backfill-product-collections.ts",
    "release:check": "npm run lint && npx tsc --noEmit && npm run env:inventory && npm test && npm run security:audit && npm run test:e2e:a11y && npm run test:e2e:contrast && npm run test:e2e:screen-reader && npm run test:e2e:critical && npm run test:e2e:screenshots && npm run test:e2e:perf && npm run test:e2e:perf:throttled && npm run build && npm run test:lighthouse",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "content:seed": "tsx scripts/seed-page-content.ts",
    "import:woocommerce": "tsx scripts/import-woocommerce-products.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "emailjs": "^5.0.1",
    "framer-motion": "^12.42.2",
    "image-size": "^2.0.2",
    "imapflow": "^1.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "resend": "^6.12.4",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "lighthouse": "^12.8.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "1.19.13"
    },
    "postcss": "8.5.16",
    "uuid": "11.1.1"
  }
}
